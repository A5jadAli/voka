{
  "name": "voka",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "qa:web:serve": "npm run export:web && serve -s dist -l 4173",
    "doctor": "expo-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint --max-warnings=0",
    "lint:fix": "expo lint --fix",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:realtime": "node --env-file=.env.local scripts/realtime-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "run-s doctor format:check typecheck lint test:ci",
    "validate:release": "npm run validate && npm run test:e2e",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  },
  "packageManager": "npm@11.16.0",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run validate"
  },
  "private": true
}
