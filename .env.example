# Public client configuration. These values are safe to bundle in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: use a different HTTPS endpoint instead of the Supabase function.
# EXPO_PUBLIC_VOKA_API_URL=https://api.example.com/realtime-session

# Never put OPENAI_API_KEY or any other provider secret in an EXPO_PUBLIC variable.
