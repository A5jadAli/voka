# Public client configuration. These values are safe to bundle in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public RevenueCat SDK keys. Omit to disable native purchase/restore actions.
# The Plus information screen remains available. Server configuration must also enable sales.
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_PUBLIC_SDK_KEY
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_PUBLIC_SDK_KEY

# Server-only billing secrets belong in Supabase, NEVER in an EXPO_PUBLIC variable:
# REVENUECAT_SECRET_API_KEY (RevenueCat REST v1 secret key)
# REVENUECAT_WEBHOOK_AUTH (full Authorization value, at least 32 characters)
# REVENUECAT_WEBHOOK_SIGNING_SECRET (RevenueCat integration HMAC signing secret)

# Optional: use a different HTTPS endpoint instead of the Supabase function.
# EXPO_PUBLIC_VOKA_API_URL=https://api.example.com/realtime-session

# Never put OPENAI_API_KEY, XAI_API_KEY, or another provider secret in an EXPO_PUBLIC variable.
